rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Fields this write changes (update only).
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function booking(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    function bookingExists(bookingId) {
      return exists(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    // A user's own profile. The role is chosen once at sign-up and can't be
    // switched afterwards (that would let a farmer turn into a breeder).
    match /users/{userId} {
      allow read, delete: if isSignedIn() && uid() == userId;
      allow create: if isSignedIn() && uid() == userId &&
        request.resource.data.role in ['farmer', 'breeder'];
      allow update: if isSignedIn() && uid() == userId &&
        !changed().hasAny(['role', 'id']);
    }

    // Username -> email lookup, keyed by the lowercased username. Firebase
    // Auth only ever authenticates by email, so logging in with a username
    // means resolving it to an email *before* the user is signed in — hence
    // the public read. Two deliberate limits contain that exposure:
    //   - `get` only, never `list`, so the table can't be scraped wholesale;
    //     an attacker has to already know the exact username to learn anything.
    //   - create only, never update/delete, which also makes claiming a
    //     username atomic: a second claim on a taken name is an update, and
    //     updates are denied, so two people can't race onto the same name.
    // The email must be the signer's own, so nobody can point a username at
    // someone else's address.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'email']) &&
        request.resource.data.uid == uid() &&
        request.resource.data.email.lower() == request.auth.token.email.lower();
    }

    // A breeder's public farm profile, keyed by their uid. Only the owner can
    // write it, and ownership (userId) can never be reassigned — previously
    // anyone could take over a farm by writing their own uid into userId.
    match /breeders/{breederId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && uid() == breederId &&
        request.resource.data.userId == uid();
      allow update: if isSignedIn() &&
        (uid() == breederId || resource.data.userId == uid()) &&
        !changed().hasAny(['userId']);
      allow delete: if isSignedIn() &&
        (uid() == breederId || resource.data.userId == uid());
    }

    // Stud pig listings. Only the owning breeder can write, and a pig can't
    // be moved to another breeder.
    match /stud_pigs/{pigId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.breederId == uid();
      allow update: if isSignedIn() &&
        resource.data.breederId == uid() &&
        request.resource.data.breederId == uid();
      allow delete: if isSignedIn() && resource.data.breederId == uid();
    }

    // Bookings. A farmer creates them as pending; afterwards only the status
    // (plus completedAt) can change, and only along the real flow:
    //   breeder: pending -> accepted | rejected, done_breeding -> completed
    //   farmer:  accepted -> done_breeding, accepted | done_breeding -> completed
    //   either:  pending | accepted -> cancelled
    // So a farmer can't accept their own booking, nobody can reopen a finished
    // one, and names/prices/dates can't be rewritten after the fact.
    match /bookings/{bookingId} {
      function isFarmer() {
        return resource.data.farmerId == uid();
      }
      function isBreeder() {
        return resource.data.breederId == uid();
      }
      function from(statuses) {
        return resource.data.status in statuses;
      }
      function to(status) {
        return request.resource.data.status == status;
      }

      allow read: if isSignedIn() && (isFarmer() || isBreeder());
      allow create: if isSignedIn() &&
        request.resource.data.farmerId == uid() &&
        request.resource.data.breederId != uid() &&
        request.resource.data.status == 'pending' &&
        isShortString(request.resource.data.notes, 1000);
      allow update: if isSignedIn() && (isFarmer() || isBreeder()) &&
        changed().hasOnly(['status', 'completedAt']) && (
          (isBreeder() && from(['pending']) && (to('accepted') || to('rejected'))) ||
          (isBreeder() && from(['done_breeding']) && to('completed')) ||
          (isFarmer() && from(['accepted']) && to('done_breeding')) ||
          (isFarmer() && from(['accepted', 'done_breeding']) && to('completed')) ||
          (from(['pending', 'accepted']) && to('cancelled'))
        );
      allow delete: if false;
    }

    // Slim mirror of each booking's date/time/pig/status, used only to check
    // for double-booking conflicts. Deliberately excludes names and other
    // personal data so it can be safely readable by any signed-in user,
    // unlike the full /bookings document. Writes must match the booking.
    match /booking_slots/{bookingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && bookingExists(bookingId) &&
        (booking(bookingId).farmerId == uid() ||
         booking(bookingId).breederId == uid()) &&
        request.resource.data.breederId == booking(bookingId).breederId &&
        request.resource.data.status == booking(bookingId).status;
      allow delete: if false;
    }

    // In-app notifications. Anyone signed in may notify another user (booking
    // and chat events are written by the acting user's app), but only with
    // the expected shape, as unread, and never to themselves; only the
    // recipient can read, mark read or delete.
    match /notifications/{notificationId} {
      allow read, delete: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(
          ['userId', 'title', 'body', 'type', 'referenceId', 'isRead', 'createdAt']) &&
        request.resource.data.userId is string &&
        request.resource.data.userId != uid() &&
        request.resource.data.type in ['booking', 'chat', 'review', 'trip'] &&
        request.resource.data.isRead == false &&
        isShortString(request.resource.data.title, 200) &&
        isShortString(request.resource.data.body, 2000);
      allow update: if isSignedIn() && resource.data.userId == uid() &&
        changed().hasOnly(['isRead']);
    }

    // One room per farmer/breeder pair. Participants are fixed at creation.
    match /chat_rooms/{roomId} {
      allow read: if isSignedIn() && (
        resource == null ||
        uid() in resource.data.participants
      );
      allow create: if isSignedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        uid() in request.resource.data.participants &&
        request.resource.data.farmerId in request.resource.data.participants &&
        request.resource.data.breederId in request.resource.data.participants;
      allow update: if isSignedIn() && uid() in resource.data.participants &&
        !changed().hasAny(['participants', 'farmerId', 'breederId']);
      allow delete: if isSignedIn() && uid() in resource.data.participants;
    }

    match /chat_rooms/{roomId}/messages/{messageId} {
      function isParticipant() {
        return uid() in
          get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
      }

      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/chat_rooms/$(roomId)) &&
        isParticipant();
      // Messages are sent as yourself only (no impersonating the other side).
      allow create: if isSignedIn() &&
        exists(/databases/$(database)/documents/chat_rooms/$(roomId)) &&
        isParticipant() &&
        request.resource.data.senderId == uid() &&
        isShortString(request.resource.data.text, 5000);
      allow update: if isSignedIn() && uid() == resource.data.senderId &&
        !changed().hasAny(['senderId']);
      allow delete: if isSignedIn() && uid() == resource.data.senderId;
    }

    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    match /reviews/{reviewId} {
      function validRating(r) {
        return r is number && r >= 1 && r <= 5;
      }

      // ReviewModel writes farmerId, not userId — a review is always
      // authored by the farmer on that booking.
      allow read: if isSignedIn();
      // A review must belong to a booking this farmer actually made with this
      // breeder, so nobody can post ratings for a breeder they never booked.
      // Status isn't checked on purpose: the review dialog opens while the
      // booking is still being marked completed.
      allow create: if isSignedIn() &&
        request.resource.data.farmerId == uid() &&
        bookingExists(request.resource.data.bookingId) &&
        booking(request.resource.data.bookingId).farmerId == uid() &&
        booking(request.resource.data.bookingId).breederId ==
          request.resource.data.breederId &&
        validRating(request.resource.data.rating) &&
        validRating(request.resource.data.studPigRating) &&
        isShortString(request.resource.data.review, 2000);
      allow update: if isSignedIn() && resource.data.farmerId == uid() &&
        !changed().hasAny(['farmerId', 'bookingId', 'breederId']) &&
        validRating(request.resource.data.rating);
      allow delete: if isSignedIn() && resource.data.farmerId == uid();
    }

    // A farmer's pinned farm location, kept separate from their /users doc
    // so breeders can read it for directions/tracking without exposing the
    // rest of the farmer's profile — mirrors breeders' own coordinates
    // already being public.
    match /farmer_locations/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && uid() == userId;
    }

    // Live trip state for a booking. Only that booking's breeder can write
    // it, for that booking's farmer; only the two people on it can read it.
    match /trip_locations/{bookingId} {
      // resource == null lets a participant watch a trip before the breeder
      // has started it. Without it, reading the not-yet-existing document is
      // denied, which ends the farmer's live stream for good — so the trip
      // never appears even after the breeder presses Start Trip.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.farmerId == uid() ||
        resource.data.breederId == uid()
      );
      allow create, update: if isSignedIn() &&
        request.resource.data.breederId == uid() &&
        bookingExists(bookingId) &&
        booking(bookingId).breederId == uid() &&
        booking(bookingId).farmerId == request.resource.data.farmerId;
    }
  }
}
