rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Username -> email lookup, keyed by the lowercased username. Firebase
    // Auth only ever authenticates by email, so logging in with a username
    // means resolving it to an email *before* the user is signed in — hence
    // the public read. Two deliberate limits contain that exposure:
    //   - `get` only, never `list`, so the table can't be scraped wholesale;
    //     an attacker has to already know the exact username to learn anything.
    //   - create only, never update/delete, which also makes claiming a
    //     username atomic: a second claim on a taken name is an update, and
    //     updates are denied, so two people can't race onto the same name.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /breeders/{breederId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (
        request.auth.uid == breederId ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource.data.userId == request.auth.uid)
      );
    }

    match /stud_pigs/{pigId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (
        (resource != null && resource.data.breederId == request.auth.uid) ||
        (request.resource.data.breederId == request.auth.uid)
      );
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.breederId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.farmerId == request.auth.uid ||
        request.resource.data.breederId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.breederId == request.auth.uid
      );
    }

    // Slim mirror of each booking's date/time/pig/status, used only to check
    // for double-booking conflicts. Deliberately excludes names and other
    // personal data so it can be safely readable by any signed-in user,
    // unlike the full /bookings document. Writes are gated on the caller
    // owning the corresponding /bookings document.
    match /booking_slots/{bookingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() &&
        exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
        (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.farmerId == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.breederId == request.auth.uid
        );
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /chat_rooms/{roomId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.participants
      );
      allow create: if isSignedIn() && request.resource.data.participants is list && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;
    }

    match /chat_rooms/{roomId}/messages/{messageId} {
      allow read: if isSignedIn() && (
        exists(/databases/$(database)/documents/chat_rooms/$(roomId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants
      );
      allow create: if isSignedIn() && (
        exists(/databases/$(database)/documents/chat_rooms/$(roomId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants
      );
      allow update: if isSignedIn() && request.auth.uid == resource.data.senderId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
    }

    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      // ReviewModel writes farmerId, not userId — a review is always
      // authored by the farmer on that booking.
      allow read: if isSignedIn();
      // A review must belong to a booking this farmer actually made, so nobody
      // can post ratings for a breeder they never booked. Status isn't
      // checked on purpose: the review dialog opens while the booking is
      // still being marked completed.
      allow create: if isSignedIn() &&
        request.resource.data.farmerId == request.auth.uid &&
        exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)) &&
        get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.farmerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.farmerId == request.auth.uid;
    }

    // A farmer's pinned farm location, kept separate from their /users doc
    // so breeders can read it for directions/tracking without exposing the
    // rest of the farmer's profile — mirrors breeders' own coordinates
    // already being public.
    match /farmer_locations/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Live breeder position for an in-progress trip to a booking's farmer.
    // Only the breeder on that booking can write it; only the two people on
    // that booking can read it.
    match /trip_locations/{bookingId} {
      // resource == null lets a participant watch a trip before the breeder
      // has started it. Without it, reading the not-yet-existing document is
      // denied, which ends the farmer's live stream for good — so the trip
      // never appears even after the breeder presses Start Trip.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.farmerId == request.auth.uid ||
        resource.data.breederId == request.auth.uid
      );
      allow create, update: if isSignedIn() &&
        request.resource.data.breederId == request.auth.uid;
    }
  }
}
