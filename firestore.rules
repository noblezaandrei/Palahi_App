rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Fields this write changes (update only).
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function booking(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    function bookingExists(bookingId) {
      return exists(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    // A user's role from their /users profile. Fails closed: with no profile
    // the lookup errors and the rule using it denies.
    function roleOf(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role.lower();
    }

    function hasBreederRole(userId) {
      return roleOf(userId) == 'breeder';
    }

    function hasFarmerRole(userId) {
      return roleOf(userId) == 'farmer';
    }

    // The /slot_locks id for a booking's stud pig and date — a pig breeds at
    // most once a day. Must match slotLockId() in
    // breeding_request_repository.dart.
    function slotLockId(b) {
      return b.studPigId + '_' + b.bookingDate;
    }

    // "hh:mm AM/PM" from 08:00 AM to 05:00 PM, matching isWithinBookingHours()
    // and formatBookingTime() in date_utils.dart. No night bookings.
    function isDaytimeBookingTime(t) {
      return t is string &&
        t.matches('(0[89]|1[01]):[0-5][0-9] AM|(12|0[1-4]):[0-5][0-9] PM|05:00 PM');
    }

    function chatRoom(roomId) {
      return get(/databases/$(database)/documents/chat_rooms/$(roomId)).data;
    }

    // A user's own profile. The role is chosen once at sign-up and can't be
    // switched afterwards (that would let a farmer turn into a breeder).
    match /users/{userId} {
      allow read, delete: if isSignedIn() && uid() == userId;
      allow create: if isSignedIn() && uid() == userId &&
        request.resource.data.role in ['farmer', 'breeder'];
      allow update: if isSignedIn() && uid() == userId &&
        !changed().hasAny(['role', 'id']);
    }

    // Username -> email lookup, keyed by the lowercased username. Firebase
    // Auth only ever authenticates by email, so logging in with a username
    // means resolving it to an email *before* the user is signed in — hence
    // the public read. Two deliberate limits contain that exposure:
    //   - `get` only, never `list`, so the table can't be scraped wholesale;
    //     an attacker has to already know the exact username to learn anything.
    //   - create only, never update/delete, which also makes claiming a
    //     username atomic: a second claim on a taken name is an update, and
    //     updates are denied, so two people can't race onto the same name.
    // The email must be the signer's own, so nobody can point a username at
    // someone else's address. The owner may delete it when deleting their
    // account, which frees the name for someone else.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'email']) &&
        request.resource.data.uid == uid() &&
        request.resource.data.email.lower() == request.auth.token.email.lower();
      allow delete: if isSignedIn() && resource.data.uid == uid();
    }

    // A breeder's public farm profile, keyed by their uid. Only the owner can
    // write it, and ownership (userId) can never be reassigned — previously
    // anyone could take over a farm by writing their own uid into userId.
    // Only breeder accounts can create one, so a farmer can't list a farm.
    match /breeders/{breederId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && uid() == breederId &&
        request.resource.data.userId == uid() &&
        hasBreederRole(uid());
      allow update: if isSignedIn() &&
        (uid() == breederId || resource.data.userId == uid()) &&
        !changed().hasAny(['userId']);
      allow delete: if isSignedIn() &&
        (uid() == breederId || resource.data.userId == uid());
    }

    // Stud pig listings. Only breeder accounts can list pigs, only the owning
    // breeder can write, and a pig can't be moved to another breeder.
    match /stud_pigs/{pigId} {
      function validPrice() {
        return request.resource.data.price is number &&
          request.resource.data.price >= 0;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.breederId == uid() &&
        hasBreederRole(uid()) &&
        validPrice();
      allow update: if isSignedIn() &&
        resource.data.breederId == uid() &&
        request.resource.data.breederId == uid() &&
        validPrice();
      allow delete: if isSignedIn() && resource.data.breederId == uid();
    }

    // Bookings. A farmer creates them as pending; afterwards only the status
    // (plus completedAt) can change, and only along the real flow:
    //   breeder: pending -> accepted | rejected, done_breeding -> completed
    //   farmer:  accepted -> done_breeding, accepted | done_breeding -> completed
    //   either:  pending | accepted -> cancelled
    // So a farmer can't accept their own booking, nobody can reopen a finished
    // one, and names/prices/dates can't be rewritten after the fact.
    match /bookings/{bookingId} {
      function isFarmer() {
        return resource.data.farmerId == uid();
      }
      function isBreeder() {
        return resource.data.breederId == uid();
      }
      function from(statuses) {
        return resource.data.status in statuses;
      }
      function to(status) {
        return request.resource.data.status == status;
      }

      // The booking must claim its pig/date slot lock in the same write (see
      // /slot_locks), so a pig can never be booked twice on one day.
      function claimsItsSlot() {
        let data = request.resource.data;
        return getAfter(/databases/$(database)/documents/slot_locks/$(slotLockId(data))).data.bookingId == bookingId;
      }

      allow read: if isSignedIn() && (isFarmer() || isBreeder());
      // Only a farmer can book, and only with a real breeder — otherwise a
      // booking to any uid would unlock notifying (and reviewing) that user.
      allow create: if isSignedIn() &&
        request.resource.data.farmerId == uid() &&
        request.resource.data.breederId is string &&
        request.resource.data.breederId != uid() &&
        isShortString(request.resource.data.bookingDate, 10) &&
        isDaytimeBookingTime(request.resource.data.bookingTime) &&
        exists(/databases/$(database)/documents/breeders/$(request.resource.data.breederId)) &&
        // The pig must be this breeder's, so the pig/day lock can't be
        // claimed under a pig from a different farm.
        request.resource.data.studPigId is string &&
        get(/databases/$(database)/documents/stud_pigs/$(request.resource.data.studPigId)).data.breederId == request.resource.data.breederId &&
        hasFarmerRole(uid()) &&
        request.resource.data.status == 'pending' &&
        isShortString(request.resource.data.notes, 1000) &&
        claimsItsSlot();
      allow update: if isSignedIn() && (isFarmer() || isBreeder()) &&
        changed().hasOnly(['status', 'completedAt']) && (
          (isBreeder() && from(['pending']) && (to('accepted') || to('rejected'))) ||
          (isBreeder() && from(['done_breeding']) && to('completed')) ||
          (isFarmer() && from(['accepted']) && to('done_breeding')) ||
          (isFarmer() && from(['accepted', 'done_breeding']) && to('completed')) ||
          (from(['pending', 'accepted']) && to('cancelled'))
        );
      allow delete: if false;
    }

    // Slim mirror of each booking's date/time/pig/status, used only to check
    // for double-booking conflicts. Deliberately excludes names and other
    // personal data so it can be safely readable by any signed-in user,
    // unlike the full /bookings document. Writes must match the booking.
    // getAfter, so it can be written in the same batch as the booking.
    match /booking_slots/{bookingId} {
      function bookingAfter() {
        return getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }

      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        existsAfter(/databases/$(database)/documents/bookings/$(bookingId)) &&
        (bookingAfter().farmerId == uid() || bookingAfter().breederId == uid()) &&
        request.resource.data.breederId == bookingAfter().breederId &&
        request.resource.data.status == bookingAfter().status;
      allow delete: if false;
    }

    // The atomic double-booking guard: one document per stud pig and day
    // ("<studPigId>_<yyyy-MM-dd>"), naming the booking that holds it — a pig
    // breeds at most once a day. It's written in the same batch as the
    // booking, and a second claim on a taken day is an update, which is only
    // allowed once the holding booking was cancelled or rejected — so when
    // two farmers book the same pig and day at once, exactly one gets it.
    match /slot_locks/{slotId} {
      function claimedBooking() {
        return getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data;
      }

      function validClaim() {
        let b = claimedBooking();
        return request.resource.data.keys().hasOnly(['bookingId']) &&
          b.farmerId == uid() &&
          b.status == 'pending' &&
          slotId == slotLockId(b);
      }

      // Only a booking id; lets the app tell "slot taken" from other errors.
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && validClaim();
      allow update: if isSignedIn() && validClaim() &&
        booking(resource.data.bookingId).status in ['cancelled', 'rejected'];
      allow delete: if false;
    }

    // In-app notifications, written by the acting user's app. A user can only
    // notify the other party on a booking or chat room they're both on, and
    // referenceId must point at it — so nobody can message arbitrary users
    // (e.g. fake "account suspended" alerts). Only the recipient can read,
    // mark read or delete.
    match /notifications/{notificationId} {
      function n() {
        return request.resource.data;
      }

      // The sender and recipient are the booking's farmer and breeder.
      function aboutSharedBooking() {
        let b = booking(n().referenceId);
        return (b.farmerId == uid() && b.breederId == n().userId) ||
          (b.breederId == uid() && b.farmerId == n().userId);
      }

      // The sender and recipient are both in the chat room.
      function aboutSharedChat() {
        let participants = chatRoom(n().referenceId).participants;
        return uid() in participants && n().userId in participants;
      }

      allow read, delete: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() &&
        n().keys().hasOnly(
          ['userId', 'title', 'body', 'type', 'referenceId', 'isRead', 'createdAt']) &&
        n().userId is string &&
        n().userId != uid() &&
        n().isRead == false &&
        isShortString(n().title, 200) &&
        isShortString(n().body, 2000) &&
        n().referenceId is string && n().referenceId.size() > 0 &&
        ((n().type == 'booking' && aboutSharedBooking()) ||
         (n().type == 'chat' && aboutSharedChat()));
      allow update: if isSignedIn() && resource.data.userId == uid() &&
        changed().hasOnly(['isRead']);
    }

    // One room per farmer/breeder pair. Participants are fixed at creation.
    // The room id must be the two sorted uids joined by '_' (what the app
    // derives), and those uids must be exactly the room's participants —
    // otherwise a third user could pre-create "farmer_breeder" with
    // themselves inside and hijack that pair's conversation.
    match /chat_rooms/{roomId} {
      function room() {
        return request.resource.data;
      }

      allow read: if isSignedIn() && (
        resource == null ||
        uid() in resource.data.participants
      );
      allow create: if isSignedIn() &&
        room().participants is list &&
        room().participants.size() == 2 &&
        room().participants[0] < room().participants[1] &&
        roomId == room().participants[0] + '_' + room().participants[1] &&
        uid() in room().participants &&
        room().farmerId in room().participants &&
        room().breederId in room().participants &&
        room().farmerId != room().breederId &&
        hasFarmerRole(room().farmerId) &&
        hasBreederRole(room().breederId);
      allow update: if isSignedIn() && uid() in resource.data.participants &&
        !changed().hasAny(['participants', 'farmerId', 'breederId']);
      allow delete: if isSignedIn() && uid() in resource.data.participants;
    }

    match /chat_rooms/{roomId}/messages/{messageId} {
      function isParticipant() {
        return uid() in
          get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
      }

      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/chat_rooms/$(roomId)) &&
        isParticipant();
      // Messages are sent as yourself only (no impersonating the other side).
      allow create: if isSignedIn() &&
        exists(/databases/$(database)/documents/chat_rooms/$(roomId)) &&
        isParticipant() &&
        request.resource.data.senderId == uid() &&
        isShortString(request.resource.data.text, 5000);
      // Only your own reaction, and only one of the app's emojis.
      function ownReactionOnly() {
        let after = request.resource.data.reactions;
        let before = resource.data.get('reactions', {});
        return after is map &&
          after.diff(before).affectedKeys().hasOnly([uid()]) &&
          (!(uid() in after) ||
           after[uid()] in ['👍', '❤️', '😂', '😮', '😢', '🙏']);
      }

      // The sender may edit their message (but not who sent it, or anyone's
      // reactions). Only the *other* participant may react — nobody reacts
      // to their own messages.
      allow update: if isSignedIn() && (
        (uid() == resource.data.senderId &&
          !changed().hasAny(['senderId', 'reactions'])) ||
        (isParticipant() && uid() != resource.data.senderId &&
          changed().hasOnly(['reactions']) && ownReactionOnly())
      );
      allow delete: if isSignedIn() && uid() == resource.data.senderId;
    }

    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    match /reviews/{reviewId} {
      function validRating(r) {
        return r is number && r >= 1 && r <= 5;
      }

      // ReviewModel writes farmerId, not userId — a review is always
      // authored by the farmer on that booking.
      allow read: if isSignedIn();
      function validText() {
        return isShortString(request.resource.data.review, 2000) &&
          (!('studPigReview' in request.resource.data) ||
           isShortString(request.resource.data.studPigReview, 2000));
      }

      // A review must belong to a *completed* booking this farmer made with
      // this breeder, and its id must be that booking's id — so there's at
      // most one review per booking, and nobody can rate a breeder from a
      // booking they never went through with (or cancelled). The app waits
      // for the booking to be marked completed before submitting.
      allow create: if isSignedIn() &&
        request.resource.data.farmerId == uid() &&
        reviewId == request.resource.data.bookingId &&
        bookingExists(reviewId) &&
        booking(reviewId).farmerId == uid() &&
        booking(reviewId).breederId == request.resource.data.breederId &&
        booking(reviewId).status == 'completed' &&
        validRating(request.resource.data.rating) &&
        validRating(request.resource.data.studPigRating) &&
        validText();
      allow update: if isSignedIn() && resource.data.farmerId == uid() &&
        !changed().hasAny(['farmerId', 'bookingId', 'breederId']) &&
        validRating(request.resource.data.rating) &&
        validRating(request.resource.data.studPigRating) &&
        validText();
      allow delete: if isSignedIn() && resource.data.farmerId == uid();
    }

    // A farmer's pinned farm location, kept separate from their /users doc
    // so breeders can read it for directions/tracking without exposing the
    // rest of the farmer's profile. It's a home address, so it is private:
    // the farmer can read their own, and a breeder can fetch one farmer's
    // pin by id (for a booking's trip), but nobody can list them all and
    // other farmers can't read them at all.
    match /farmer_locations/{userId} {
      allow get: if isSignedIn() &&
        (uid() == userId || hasBreederRole(uid()));
      allow list: if false;
      allow create, update, delete: if isSignedIn() && uid() == userId;
    }

    // Live trip state for a booking. Only that booking's breeder can write
    // it, for that booking's farmer; only the two people on it can read it.
    match /trip_locations/{bookingId} {
      // resource == null lets a participant watch a trip before the breeder
      // has started it. Without it, reading the not-yet-existing document is
      // denied, which ends the farmer's live stream for good — so the trip
      // never appears even after the breeder presses Start Trip.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.farmerId == uid() ||
        resource.data.breederId == uid()
      );
      allow create, update: if isSignedIn() &&
        request.resource.data.breederId == uid() &&
        bookingExists(bookingId) &&
        booking(bookingId).breederId == uid() &&
        booking(bookingId).farmerId == request.resource.data.farmerId;
    }
  }
}
